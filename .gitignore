__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Archive: raw media, derived files and the live DB stay out of git (size, licensing).
# Parquet snapshots ARE committed so the tables survive the ephemeral container;
# scripts/setup.sh restores them into a fresh DB.
archive/*
!archive/README.md
!archive/parquet/
archive/parquet/*
!archive/parquet/*.parquet

# yt-dlp cookies must never be committed
cookies*.txt
