__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# data/: raw media, processed media and the live DB stay out of git (size, licensing).
# Parquet snapshots ARE committed so the tables survive the ephemeral container;
# scripts/setup.sh restores them into a fresh DB.
data/raw/
data/processed/
data/exports/
data/*.duckdb
data/*.duckdb.wal

# yt-dlp cookies and API keys must never be committed
cookies*.txt
.env
data/market.duckdb*
data/recorder.pid
data/recorder_status.json
data/logs/
data/raw/streams_corrupt/
data/stream_watcher_status.json
data/stream_watcher.pid
